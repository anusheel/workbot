# The Anthropic key, for pnpm chat and every model call.
ANTHROPIC_API_KEY=
# Optional. Only for --provider openai and CHAT_PROVIDER=openai.
# OPENAI_API_KEY=
# Optional. The web chat's provider (anthropic or openai) and a model instead of its default.
# CHAT_PROVIDER=
# CHAT_MODEL=
# Optional. A Brave Search key; without it the assistant has no web search.
# BRAVE_SEARCH_KEY=
# Optional. A Voyage AI key; with it the knowledge base is searched by meaning as well as by words.
# VOYAGE_API_KEY=

# A postgres:// URL. Unset, the app runs on an embedded database in .data/pg.
DATABASE_URL=

# Optional. The PostHog project key for capturing events; unset means no analytics.
# POSTHOG_KEY=
# Optional. A project id and personal key for reading events back through the PostHog MCP server.
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_KEY=
