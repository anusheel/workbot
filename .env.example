# The Anthropic key, for pnpm chat and every model call.
ANTHROPIC_API_KEY=
# Optional. For the openai routes and pnpm chat --provider openai.
# OPENAI_API_KEY=
# Optional. A task's model instead of the routing table's first, as task=provider/size pairs.
# ROUTES=chat=anthropic/small,generate=anthropic/small
# Optional. Providers or model ids to fail every call to, to rehearse an outage.
# OUTAGE=claude-haiku-5-5
# Optional. The customer this deployment serves: a file in content/customers; fieldstone when unset.
# CUSTOMER=fieldstone
# Optional. Seals the integration tokens people connect, 32 bytes as base64 (openssl rand -base64 32); without it, no one can connect one. During a rotation, the old key goes in SECRETS_KEY_PREVIOUS until `pnpm users reseal` has run.
# SECRETS_KEY=
# SECRETS_KEY_PREVIOUS=
# Optional. The ticketing system: a GitHub token (repo scope) and the repository whose issues are the tickets. Unset, the ticket tools and the sync are off.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name
# Optional. Signs the ticketing system's webhook deliveries to /api/webhooks/github; unset, deliveries are refused.
# GITHUB_WEBHOOK_SECRET=
# Optional. A Brave Search key; without it the assistant has no web search.
# BRAVE_SEARCH_KEY=
# Optional. The address the app is reached at from outside, such as https://workbot.example: a provider signs each webhook over the URL it called, and a status callback needs somewhere to go.
# APP_URL=
# Optional. SMS and WhatsApp through Twilio: the account, the numbers it sends from, an approved WhatsApp template (a Content SID) for messages outside the 24-hour window, and a regional API host. Without the account they are off.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15105550100
# TWILIO_WHATSAPP_FROM=+15105550100
# TWILIO_WHATSAPP_TEMPLATE=
# TWILIO_API_URL=https://api.twilio.com
# Optional. A realtime server's address (pnpm realtime runs one); with it, staff follow voice calls live at /admin/calls.
# REALTIME_URL=ws://localhost:3301
# Optional. The Slack app's bot token and signing secret, and the bot's user id, which saves asking Slack on each cold start; events go to /api/webhooks/slack. Without the first two Slack is off.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_USER_ID=U0123ABCD
# Optional. A Voyage AI key; with it the knowledge base is searched by meaning as well as by words.
# VOYAGE_API_KEY=
# Optional. The daily model spend, in dollars, past which the hourly watch raises an alert. Default 5.
# ALERT_DAILY_DOLLARS=
# Optional. Inngest Cloud keys for the workflows in production; unset, they run through the dev server (pnpm inngest).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# A postgres:// URL. Unset, the app runs on an embedded database in .data/pg.
DATABASE_URL=

# Optional. The PostHog project key for capturing events; unset means no analytics.
# POSTHOG_KEY=
# Optional. The PostHog ingestion host, for a project in another region. Default https://us.i.posthog.com.
# POSTHOG_HOST=https://us.i.posthog.com
# Optional. The PostHog API host the MCP server reads from. Default https://us.posthog.com.
# POSTHOG_API_HOST=https://us.posthog.com
# Optional. A project id and personal key for reading events back through the PostHog MCP server.
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_KEY=
