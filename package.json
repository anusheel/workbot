{
  "name": "workbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "chat": "node --env-file-if-exists=.env.local --import tsx cli/chat.ts",
    "explain": "node --import tsx cli/explain.ts",
    "scrape": "node --env-file-if-exists=.env.local --import tsx cli/scrape.ts",
    "browse": "node --env-file-if-exists=.env.local --import tsx cli/browse.ts",
    "video": "node --env-file-if-exists=.env.local --import tsx cli/video.ts",
    "extract": "node --env-file-if-exists=.env.local --import tsx cli/extract.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx cli/eval.ts",
    "eval:generate": "node --env-file-if-exists=.env.local --import tsx cli/eval-generate.ts",
    "eval:calibrate": "node --env-file-if-exists=.env.local --import tsx cli/eval-calibrate.ts",
    "routes": "node --env-file-if-exists=.env.local --import tsx cli/routes.ts",
    "frameworks": "node --env-file-if-exists=.env.local --import tsx cli/frameworks.ts",
    "sync:commands": "node scripts/sync-commands.mjs",
    "knowledge:index": "node --env-file-if-exists=.env.local --import tsx cli/index-knowledge.ts",
    "compare:retrieval": "node --env-file-if-exists=.env.local --import tsx cli/compare-retrieval.ts",
    "compare:agents": "node --env-file-if-exists=.env.local --import tsx cli/compare-agents.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm --filter workbot-site check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/provider": "^4.0.34",
    "@ai-sdk/react": "^4.0.157",
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@json-render/core": "^0.21.3",
    "@json-render/react": "^0.21.3",
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "0.21.0",
    "@openai/agents-extensions": "0.21.0",
    "ai": "^7.0.153",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "inngest": "^4.26.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "playwright-core": "^1.64.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inngest/test": "^1.0.0",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "inngest-cli": "^1.49.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.14.0"
}
