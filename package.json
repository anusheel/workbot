{
  "name": "workbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "chat": "node --env-file-if-exists=.env.local --import tsx cli/chat.ts",
    "explain": "node --import tsx cli/explain.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm --filter workbot-site check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/react": "^4.0.157",
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.11",
    "@json-render/core": "^0.21.3",
    "@json-render/react": "^0.21.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.153",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.14.0"
}
