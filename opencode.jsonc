// OpenCode, project scope. The same policy as .claude/settings.json and .codex/config.toml:
// the instruction files of every package, the 5 MCP servers of .mcp.json, the skills as commands.
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "site/AGENTS.md",
    "src/app/api/AGENTS.md",
    "content/knowledge/AGENTS.md",
    "brain/README.md",
  ],
  "permission": {
    // `.env` and `.env.*` are out of reach of the file tools, as in the other 2 CLIs; .env.example is the one
    // env file the agent may read and edit. The last matching pattern wins, so the exception comes last.
    // Patterns are case-sensitive and the disk may not be: `.ENV.local` is the same file and is not matched.
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    // A command that spells an env file name (after a space, a tab, a slash, a quote, `=` or a redirect) is
    // refused even under --auto, which only answers the asks; `process.env` in a grep is not a file name and
    // still asks. This is a filter on literal lower-case names, not a boundary: a name built with a glob, a
    // variable or a script, and `grep -r KEY .`, fall through to `ask`, which --auto answers. In an
    // interactive session, "Always" on any bash prompt stores an allow rule that outranks these denies.
    "bash": {
      "*": "ask",
      "* .env*": "deny",
      "*\t.env*": "deny",
      "*/.env*": "deny",
      "*\".env*": "deny",
      "*'.env*": "deny",
      "*=.env*": "deny",
      "*<.env*": "deny",
      "*>.env*": "deny",
    },
  },
  "mcp": {
    "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp" },
    "github": { "type": "remote", "url": "https://api.githubcopilot.com/mcp/" },
    "figma": { "type": "remote", "url": "https://mcp.figma.com/mcp" },
    "database": {
      "type": "local",
      "command": [
        "node",
        "--env-file-if-exists=.env.local",
        "--import",
        "tsx",
        "mcp/database.ts",
      ],
    },
    "posthog": {
      "type": "local",
      "command": [
        "node",
        "--env-file-if-exists=.env.local",
        "--import",
        "tsx",
        "mcp/posthog.ts",
      ],
    },
  },
}
