[
  {
    "id": "phone-e164",
    "on": "contact",
    "when": [{ "field": "phone", "matches": "\\d" }],
    "then": { "normalize": "phone" }
  },
  {
    "id": "company-from-domain",
    "on": "contact",
    "when": [
      { "field": "company", "missing": true },
      { "field": "email", "matches": "@" }
    ],
    "then": { "companyFromEmail": true }
  },
  {
    "id": "route-finance",
    "on": "ticket",
    "when": [
      { "field": "team", "missing": true },
      { "field": "text", "matches": "invoice|payment|refund|credit|statement" }
    ],
    "then": { "set": { "team": "finance" } }
  },
  {
    "id": "route-support",
    "on": "ticket",
    "when": [
      { "field": "team", "missing": true },
      { "field": "text", "matches": "customer|complaint|delivery|order" }
    ],
    "then": { "set": { "team": "support" } }
  },
  {
    "id": "route-operations",
    "on": "ticket",
    "when": [
      { "field": "team", "missing": true },
      {
        "field": "text",
        "matches": "van|truck|dock|warehouse|printer|light|facilit|vendor"
      }
    ],
    "then": { "set": { "team": "operations" } }
  },
  {
    "id": "large-invoice",
    "on": "invoice",
    "when": [{ "field": "total", "over": 5000 }],
    "then": { "flag": "Total over $5,000: the finance lead approves" }
  }
]
